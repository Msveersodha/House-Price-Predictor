# ---------- SQL Server connection ----------
DB_SERVER=localhost
# Ignored when DB_SERVER is a named instance such as localhost\SQLEXPRESS
DB_PORT=1433
DB_NAME=HousePriceDB
DB_DRIVER=ODBC Driver 18 for SQL Server

# "sql"     -> SQL Server Authentication (DB_USER + DB_PASSWORD required)
# "windows" -> Windows Authentication (leave DB_USER / DB_PASSWORD empty)
DB_AUTH_MODE=sql
DB_USER=your_username
DB_PASSWORD=your_password

# ODBC Driver 18 encrypts by default. A local dev server usually has a self-signed
# certificate, so trust it. Set to "no" in production with a real certificate.
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=yes

# Database used to run CREATE DATABASE (needs dbcreator / sysadmin rights)
DB_ADMIN_DATABASE=master

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# ---------- Model ----------
MODEL_PATH=app/models/house_price_model.pkl
# The model predicts median house value in units of $100,000 (California Housing
# dataset convention). Price shown to users = model output * PRICE_UNIT_MULTIPLIER.
PRICE_CURRENCY=USD
PRICE_UNIT_MULTIPLIER=100000

# ---------- API ----------
API_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
ALLOW_DELETE=true
LOG_LEVEL=INFO
# "text" or "json"
LOG_FORMAT=text
